# Drawo environment configuration.
#
# Copy this file to .env (inside the app/ directory for local development)
# and adjust the values. This is the only configuration file Drawo reads.
# In production, set the same variables in your container orchestrator.

# Application
DRAWO_APP_NAME=Drawo
DRAWO_APP_DOMAIN=http://localhost:8080
DRAWO_APP_SECRET_KEY=change-me-to-a-long-random-string-in-production

# Server
DRAWO_SERVER_HOST=0.0.0.0
DRAWO_SERVER_PORT=8080

# Database (PostgreSQL)
DRAWO_DATABASE_HOST=localhost
DRAWO_DATABASE_PORT=5432
DRAWO_DATABASE_NAME=drawo
DRAWO_DATABASE_USER=postgres
DRAWO_DATABASE_PASSWORD=123456
DRAWO_DATABASE_SSLMODE=disable

# Redis
DRAWO_REDIS_HOST=localhost
DRAWO_REDIS_PORT=6379
DRAWO_REDIS_PASSWORD=
DRAWO_REDIS_DB=0

# Auth
DRAWO_AUTH_ISSUER=drawo
DRAWO_AUTH_AUDIENCE=drawo
DRAWO_AUTH_ACCESSTOKENEXPIRY=15m
DRAWO_AUTH_REFRESHTOKENEXPIRY=168h
DRAWO_AUTH_MAXLOGINATTEMPTS=5
DRAWO_AUTH_LOGINLOCKOUTDURATION=15m
DRAWO_AUTH_REFRESHTOKENFAMILYSIZE=10

# Logging
DRAWO_LOG_LEVEL=info
DRAWO_LOG_FORMAT=json
