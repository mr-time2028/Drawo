# Npm configuration for the Drawo frontend.
#
# - save-exact=false so new deps land with semver ranges in package.json.
# - engine-strict=false so installs don't fail on minor node version mismatches.
# - package-lock=true keeps installs reproducible; commit package-lock.json.
# - no optional/legacy-peer-deps flags here: we prefer clean peer dep graphs.

save-exact=false
engine-strict=false
package-lock=true
