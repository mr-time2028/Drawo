# Frontend local environment.
# Copy this file to .env:
#
#   cp .env.example .env
#
# Vite only exposes variables that start with VITE_.

# Go backend HTTP API base URL.
VITE_API_BASE_URL=http://localhost:8080

# Go backend WebSocket endpoint.
VITE_WS_URL=ws://localhost:8080/api/v1/ws

# Default UI language: en or fa.
VITE_DEFAULT_LANGUAGE=fa
