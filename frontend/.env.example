# Drawo frontend environment.
#
# Copy this file to frontend/.env:
#
#   cp .env.example .env
#
# The React/Vite app lives in frontend/app. Its Vite config reads env from this
# frontend project root, so do not create another env file inside frontend/app.
# Vite only exposes variables that start with VITE_.

# Local npm dev: point directly to the Go backend.
# Docker/Nginx build: leave empty to use same-origin /api proxy.
VITE_API_BASE_URL=http://localhost:8080

# Local npm dev WebSocket endpoint.
# Docker/Nginx build: leave empty to use same-origin /api/v1/ws proxy.
VITE_WS_URL=ws://localhost:8080/api/v1/ws

# Default UI language: en or fa.
VITE_DEFAULT_LANGUAGE=fa

# Docker frontend HTTP port.
FRONTEND_HTTP_PORT=3000
