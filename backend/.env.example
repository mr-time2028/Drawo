# ==============================================================================
# Drawo backend .env example
# ==============================================================================
# Copy this file to `.env` inside backend/:
#
#   cd backend
#   cp .env.example .env
#
# This is the single backend env file. backend/docker-compose.yml reads it with
# env_file and also uses it for ${...} substitutions.
#
# Docker Compose values:
#   The backend app container must use service names for infrastructure:
#
# Quick host values:
#   Local dev with `make dev-up` + local Go app:
#     DRAWO_DATABASE_HOST=localhost
#     DRAWO_REDIS_HOST=localhost
#     DRAWO_CACHE_HOST=localhost
#     DRAWO_APP_STORAGE_DRIVER=local
#     DRAWO_APP_STORAGE_UPLOADDIR=uploads
#
#   Full Docker Compose stack with app inside Docker:
#     DRAWO_DATABASE_HOST=postgres
#     DRAWO_REDIS_HOST=redis
#     DRAWO_CACHE_HOST=redis
#     DRAWO_APP_STORAGE_DRIVER=local
#     DRAWO_APP_STORAGE_UPLOADDIR=uploads
#
#     Or, if you choose to use MinIO later:
#     DRAWO_APP_STORAGE_DRIVER=minio
#     DRAWO_APP_STORAGE_ENDPOINT=minio:9000
#
#   Real production with external managed services:
#     Use your real DB/Redis/S3/MinIO hostnames and endpoints.
#
# Production checklist:
#   - Change every `change-me-*` value.
#   - Use HTTPS in DRAWO_APP_DOMAIN.
#   - Use strong DB/Redis/storage credentials.
#   - Use a production SSL mode for external Postgres when required.
#   - Do not expose MinIO console publicly unless protected.
#
# Single source of truth:
#   Keep only DRAWO_* values here. Do not add POSTGRES_* or MINIO_ROOT_* copies.
#   docker-compose.yml maps DRAWO_* values to official image variables internally.
# ==============================================================================


# ==============================================================================
# Application
# ==============================================================================

# Display/application name.
DRAWO_APP_NAME=Drawo

# Public URL. Dev: http://localhost:8080 | Prod: https://your-domain.com
DRAWO_APP_DOMAIN=http://localhost:8080

# Strong app/JWT secret. Prod: generate with `openssl rand -base64 48`.
DRAWO_APP_SECRET_KEY=change-me-to-a-long-random-string-in-production


# ==============================================================================
# Server / exposed ports
# ==============================================================================

# Bind address for the Go server. Docker usually needs 0.0.0.0.
DRAWO_SERVER_HOST=0.0.0.0

# Go app HTTP port.
DRAWO_SERVER_PORT=8080

# Nginx public ports used by docker-compose.yml.
DRAWO_NGINX_HTTP_PORT=80
DRAWO_NGINX_HTTPS_PORT=443


# ==============================================================================
# Database / PostgreSQL
# ==============================================================================

# Driver. Production should normally use postgres.
DRAWO_DATABASE_DRIVER=postgres

# Host. Dev local app: localhost | Full compose: postgres | Prod: your DB host.
DRAWO_DATABASE_HOST=localhost

# Port. Default PostgreSQL port is 5432.
DRAWO_DATABASE_PORT=5432

# Database name. Compose maps this to POSTGRES_DB.
DRAWO_DATABASE_NAME=drawo

# Database user. Prod: prefer a least-privilege user, not necessarily postgres.
DRAWO_DATABASE_USER=postgres

# Database password. Prod: MUST be a strong secret.
DRAWO_DATABASE_PASSWORD=change-me-db-password

# SSL mode. Local Docker: disable | External prod DB: require/verify-ca/verify-full.
DRAWO_DATABASE_SSLMODE=disable


# ==============================================================================
# Redis
# ==============================================================================

# Host. Dev local app: localhost | Full compose: redis | Prod: your Redis host.
DRAWO_REDIS_HOST=localhost

# Redis port.
DRAWO_REDIS_PORT=6379

# Redis password. Dev can be empty. Prod should normally be set.
DRAWO_REDIS_PASSWORD=

# Redis DB index.
DRAWO_REDIS_DB=0


# ==============================================================================
# Cache abstraction
# ==============================================================================
# Usually this points to the same Redis instance above. Keep it synchronized with
# Redis unless you intentionally run a separate cache backend.

# Cache driver.
DRAWO_CACHE_DRIVER=redis

# Cache host. Dev local app: localhost | Full compose: redis | Prod: cache host.
DRAWO_CACHE_HOST=localhost

# Cache port.
DRAWO_CACHE_PORT=6379

# Cache password. Usually same as DRAWO_REDIS_PASSWORD.
DRAWO_CACHE_PASSWORD=

# Cache DB index. Usually same as DRAWO_REDIS_DB.
DRAWO_CACHE_DB=0


# ==============================================================================
# Object storage / MinIO or S3-compatible storage
# ==============================================================================

# MinIO API port exposed by Docker Compose.
DRAWO_MINIO_API_PORT=9000

# MinIO console port exposed by Docker Compose. Protect or disable in production.
DRAWO_MINIO_CONSOLE_PORT=9001

# Storage driver.
# Current project preference: local (avoids MinIO while it is being debugged).
# To switch back to MinIO later, set this to: minio
DRAWO_APP_STORAGE_DRIVER=local

# MinIO/S3 endpoint. Ignored when DRAWO_APP_STORAGE_DRIVER=local.
# MinIO local app: localhost:9000 | Full compose: minio:9000 | Prod: provider endpoint.
DRAWO_APP_STORAGE_ENDPOINT=localhost:9000

# MinIO/S3 access key. Ignored when DRAWO_APP_STORAGE_DRIVER=local.
# Compose maps this to MINIO_ROOT_USER if MinIO is used.
DRAWO_APP_STORAGE_ACCESSKEY=admin

# MinIO/S3 secret key. Ignored when DRAWO_APP_STORAGE_DRIVER=local.
# Compose maps this to MINIO_ROOT_PASSWORD if MinIO is used. Prod: strong secret.
DRAWO_APP_STORAGE_SECRETKEY=change-me-minio-password

# Use HTTPS for MinIO/S3 connection. Ignored when DRAWO_APP_STORAGE_DRIVER=local.
# Local MinIO: false | Prod S3/TLS MinIO: true.
DRAWO_APP_STORAGE_USESSL=false

# Logical bucket/subdirectory name for uploaded files/assets.
# Local driver stores files under: DRAWO_APP_STORAGE_UPLOADDIR/DRAWO_APP_STORAGE_BUCKETNAME/
DRAWO_APP_STORAGE_BUCKETNAME=drawo

# Storage region. Ignored by local driver. MinIO often uses us-east-1.
# S3 should use the real bucket region.
DRAWO_APP_STORAGE_REGION=us-east-1

# Local upload directory used when DRAWO_APP_STORAGE_DRIVER=local.
# If you run `cd app && go run . serve`, this resolves to app/uploads.
# Local URLs returned by the provider look like: /uploads/<bucket>/<file>
DRAWO_APP_STORAGE_UPLOADDIR=uploads


# ==============================================================================
# Authentication / JWT / login security
# ==============================================================================

# JWT issuer and audience.
DRAWO_AUTH_ISSUER=drawo
DRAWO_AUTH_AUDIENCE=drawo

# Access token lifetime. Short values are safer; 15m is typical.
DRAWO_AUTH_ACCESSTOKENEXPIRY=15m

# Refresh token lifetime. 168h = 7 days.
DRAWO_AUTH_REFRESHTOKENEXPIRY=168h

# Login brute-force protection.
DRAWO_AUTH_MAXLOGINATTEMPTS=5
DRAWO_AUTH_LOGINLOCKOUTDURATION=1m

# Refresh-token rotation/reuse-detection family size.
DRAWO_AUTH_REFRESHTOKENFAMILYSIZE=10


# ==============================================================================
# Logging
# ==============================================================================

# Dev: debug/info | Prod: info/warn.
DRAWO_LOG_LEVEL=info

# Dev can use text if supported. Prod should usually use json for log collectors.
DRAWO_LOG_FORMAT=json
